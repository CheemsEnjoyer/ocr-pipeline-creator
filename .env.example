# SQLite is created automatically in data/ocr.sqlite3. Leave these unset for defaults.
# DATABASE_URL=sqlite:///data/ocr.sqlite3
# OCR_DATA_DIR=data
# BACKEND_PORT=8000
# BACKEND_URL=http://127.0.0.1:8000
LITELLM_BASE_URL=
LITELLM_API_KEY=

# External OCR service offered in the pipeline wizard. The base address is enough:
# the /api/v1/ocr/openai/file/process path is appended automatically.
OCR_SERVICE_URL=

# Corporate proxy for outgoing requests (external OCR service and LiteLLM).
# Scheme may be omitted: 10.0.0.1:8080 becomes http://10.0.0.1:8080.
# PROXY_URL=http://user:password@proxy.company.local:8080
# NO_PROXY=localhost,127.0.0.1

