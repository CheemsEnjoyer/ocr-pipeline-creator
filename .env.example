# PostgreSQL. Required password; set it before docker compose up.
POSTGRES_USER=ocr
POSTGRES_DB=ocr
POSTGRES_PASSWORD=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# DATABASE_URL=postgresql+psycopg://ocr:password@db.example.com:5432/ocr
# OCR_DATA_DIR=data
# BACKEND_PORT=8000
# BACKEND_URL=http://127.0.0.1:8000

# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# OCR_EXTERNAL_WORKER=1 # skip launching worker and dispatcher with npm run dev/start
# Background task limits (seconds). soft < hard < lease is required.
# OCR_JOB_TIMEOUT_SECONDS=600
# OCR_TASK_SOFT_LIMIT_SECONDS=240
# OCR_TASK_HARD_LIMIT_SECONDS=270
# OCR_JOB_LEASE_SECONDS=300
# OCR_JOB_MAX_ATTEMPTS=3
# OCR_JOB_RETRY_DELAY_SECONDS=10
LITELLM_BASE_URL=
LITELLM_API_KEY=

S3_BUCKET=
S3_REGION=us-east-1

S3_ENDPOINT_URL=
S3_PREFIX=originals
S3_ADDRESSING_STYLE=auto

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# OCR_ADMIN_LOGIN=admin
# OCR_ADMIN_PASSWORD=

# OCR_SECURE_COOKIE=1

# Authentication: local remains the default until Keycloak is configured.
# AUTH_PROVIDER=keycloak
# APP_PUBLIC_URL=https://ocr.example.com
# KEYCLOAK_URL=https://identity.example.com
# KEYCLOAK_REALM=company
# KEYCLOAK_CLIENT_ID=ocr
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_SESSION_KEY= # Fernet key; generate as described in README, keep across restarts.
# KEYCLOAK_ROLE_SCOPE=client # client (recommended) or realm
# KEYCLOAK_ADMIN_ROLE=admin
# KEYCLOAK_USER_ROLE=user
# Optional separate service-account client for user administration (SMTP required for invitations).
# KEYCLOAK_ADMIN_CLIENT_ID=ocr-management
# KEYCLOAK_ADMIN_CLIENT_SECRET=

# PROXY_URL=http://user:password@proxy.company.local:8080
# NO_PROXY=localhost,127.0.0.1
