# SQLite is created automatically in data/ocr.sqlite3. Leave these unset for defaults.
# DATABASE_URL=sqlite:///data/ocr.sqlite3
# OCR_DATA_DIR=data
# BACKEND_PORT=8000
# BACKEND_URL=http://127.0.0.1:8000
LITELLM_BASE_URL=
LITELLM_API_KEY=

# Admin sign-in. Login defaults to "admin"; if the password is unset, a random one
# is generated on first start and saved to data/admin-password.txt. At least 8 characters.
# OCR_ADMIN_LOGIN=admin
# OCR_ADMIN_PASSWORD=
# Set to 1 when the app is served over HTTPS so the session cookie is marked Secure.
# OCR_SECURE_COOKIE=1

# Corporate proxy for outgoing requests (external OCR service and LiteLLM).
# Scheme may be omitted: 10.0.0.1:8080 becomes http://10.0.0.1:8080.
# PROXY_URL=http://user:password@proxy.company.local:8080
# NO_PROXY=localhost,127.0.0.1

